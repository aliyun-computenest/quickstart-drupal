4ef6\u76ee\u5f55 sites/default/files \u5185\u7981\u6b62\u6267\u884c PHP \u811a\u672c\uff0c\u9632\u6b62\u4e0a\u4f20\u540e\u95e8\uff1b PHP \u914d\u7f6e expose_php = Off \uff0c\u54cd\u5e94\u5934\u4e0d\u66b4\u9732 PHP \u7248\u672c\u3002 \u5e38\u89c1\u95ee\u9898 \u90e8\u7f72\u5b8c\u6210\u540e\u8bbf\u95ee DrupalEndpoint \u6253\u4e0d\u5f00\u600e\u4e48\u529e\uff1f \u90e8\u7f72\u5b8c\u6210\u540e\u7ea6 1~2 \u5206\u949f\u5185\u521d\u59cb\u5316\u811a\u672c\u4ecd\u5728\u6267\u884c\uff0c\u8bf7\u7a0d\u7b49\u540e\u5237\u65b0\uff1b\u82e5\u957f\u65f6\u95f4\u65e0\u6cd5\u8bbf\u95ee\uff0c\u53ef\u5728\u670d\u52a1\u5b9e\u4f8b\u8be6\u60c5\u9875\u67e5\u770b\u90e8\u7f72\u65e5\u5fd7\u786e\u8ba4\u521d\u59cb\u5316\u662f\u5426\u62a5\u9519\u3002 \u4e3a\u4ec0\u4e48\u8bbf\u95ee /core/install.php \u6216 /update.php \u8fd4\u56de 403\uff1f \u8fd9\u662f\u9ed8\u8ba4\u52a0\u56fa\u7b56\u7565\uff0c\u907f\u514d\u7ad9\u70b9\u88ab\u91cd\u590d\u5b89\u88c5\u6216\u88ab\u672a\u6388\u6743\u89e6\u53d1\u5347\u7ea7\u3002\u9700\u8981\u6267\u884c\u6570\u636e\u5e93\u66f4\u65b0\u65f6\uff0c\u8bf7\u767b\u5f55 ECS \u540e\u5728 /opt/drupal \u4e0b\u4f7f\u7528 drush \u6216 php core/scripts/db-tools.php \u7b49\u547d\u4ee4\u884c\u65b9\u5f0f\u64cd\u4f5c\u3002 \u5fd8\u8bb0\u7ba1\u7406\u5458\u5bc6\u7801\u600e\u4e48\u529e\uff1f \u53ef\u767b\u5f55 ECS \u5b9e\u4f8b\uff0c\u5728 /opt/drupal \u76ee\u5f55\u4e0b\u6267\u884c drush user:password drupal_admin <\u65b0\u5bc6\u7801> \uff0c\u6216\u91cd\u65b0\u90e8\u7f72\u4e00\u4e2a\u65b0\u7684\u670d\u52a1\u5b9e\u4f8b\u3002 \u80fd\u5426\u7ed1\u5b9a\u81ea\u5df1\u7684\u57df\u540d\u5e76\u5f00\u542f HTTPS\uff1f \u53ef\u4ee5\u3002\u7ad9\u70b9\u9ed8\u8ba4\u4f7f\u7528 http://<\u516c\u7f51IP> \u8bbf\u95ee\uff0c\u5982\u9700\u7ed1\u5b9a\u57df\u540d\u4e0e\u8bc1\u4e66\uff0c\u53ef\u5728 ECS \u4e0a\u81ea\u884c\u914d\u7f6e Apache \u865a\u62df\u4e3b\u673a\uff0c\u6216\u5728\u524d\u7aef\u63a5\u5165\u8d1f\u8f7d\u5747\u8861 / CDN \u7edf\u4e00\u5904\u7406\u8bc1\u4e66\u3002 \u53c2\u8003\u6587\u6863 https://help.aliyun.com/zh/ecs/use-cases/manually-build-a-drupal-website","title":"Drupal \u8ba1\u7b97\u5de2\u5feb\u901f\u90e8\u7f72"},{"location":"#drupal","text":"\u514d\u8d23\u58f0\u660e\uff1a \u672c\u670d\u52a1\u7531\u7b2c\u4e09\u65b9\u63d0\u4f9b\uff0c\u6211\u4eec\u5c3d\u529b\u786e\u4fdd\u5176\u5b89\u5168\u6027\u3001\u51c6\u786e\u6027\u548c\u53ef\u9760\u6027\uff0c\u4f46\u65e0\u6cd5\u4fdd\u8bc1\u5176\u5b8c\u5168\u514d\u4e8e\u6545\u969c\u3001\u4e2d\u65ad\u3001\u9519\u8bef\u6216\u653b\u51fb\u3002\u56e0\u6b64\uff0c\u672c\u516c\u53f8\u5728\u6b64\u58f0\u660e\uff1a\u5bf9\u4e8e\u672c\u670d\u52a1\u7684\u5185\u5bb9\u3001\u51c6\u786e\u6027\u3001\u5b8c\u6574\u6027\u3001\u53ef\u9760\u6027\u3001\u9002\u7528\u6027\u4ee5\u53ca\u53ca\u65f6\u6027\u4e0d\u4f5c\u4efb\u4f55\u9648\u8ff0\u3001\u4fdd\u8bc1\u6216\u627f\u8bfa\uff0c\u4e0d\u5bf9\u60a8\u4f7f\u7528\u672c\u670d\u52a1\u6240\u4ea7\u751f\u7684\u4efb\u4f55\u76f4\u63a5\u6216\u95f4\u63a5\u7684\u635f\u5931\u6216\u635f\u5bb3\u627f\u62c5\u4efb\u4f55\u8d23\u4efb\uff1b\u5bf9\u4e8e\u60a8\u901a\u8fc7\u672c\u670d\u52a1\u8bbf\u95ee\u7684\u7b2c\u4e09\u65b9\u7f51\u7ad9\u3001\u5e94\u7528\u7a0b\u5e8f\u3001\u4ea7\u54c1\u548c\u670d\u52a1\uff0c\u4e0d\u5bf9\u5176\u5185\u5bb9\u3001\u51c6\u786e\u6027\u3001\u5b8c\u6574\u6027\u3001\u53ef\u9760\u6027\u3001\u9002\u7528\u6027\u4ee5\u53ca\u53ca\u65f6\u6027\u627f\u62c5\u4efb\u4f55\u8d23\u4efb\uff0c\u60a8\u5e94\u81ea\u884c\u627f\u62c5\u4f7f\u7528\u540e\u679c\u4ea7\u751f\u7684\u98ce\u9669\u548c\u8d23\u4efb\uff1b\u5bf9\u4e8e\u56e0\u60a8\u4f7f\u7528\u672c\u670d\u52a1\u800c\u4ea7\u751f\u7684\u4efb\u4f55\u635f\u5931\u3001\u635f\u5bb3\uff0c\u5305\u62ec\u4f46\u4e0d\u9650\u4e8e\u76f4\u63a5\u635f\u5931\u3001\u95f4\u63a5\u635f\u5931\u3001\u5229\u6da6\u635f\u5931\u3001\u5546\u8a89\u635f\u5931\u3001\u6570\u636e\u635f\u5931\u6216\u5176\u4ed6\u7ecf\u6d4e\u635f\u5931\uff0c\u4e0d\u627f\u62c5\u4efb\u4f55\u8d23\u4efb\uff0c\u5373\u4f7f\u672c\u516c\u53f8\u4e8b\u5148\u5df2\u88ab\u544a\u77e5\u53ef\u80fd\u5b58\u5728\u6b64\u7c7b\u635f\u5931\u6216\u635f\u5bb3\u7684\u53ef\u80fd\u6027\uff1b\u6211\u4eec\u4fdd\u7559\u4e0d\u65f6\u4fee\u6539\u672c\u58f0\u660e\u7684\u6743\u5229\uff0c\u56e0\u6b64\u8bf7\u60a8\u5728\u4f7f\u7528\u672c\u670d\u52a1\u524d\u5b9a\u671f\u68c0\u67e5\u672c\u58f0\u660e\u3002\u5982\u679c\u60a8\u5bf9\u672c\u58f0\u660e\u6216\u672c\u670d\u52a1\u5b58\u5728\u4efb\u4f55\u95ee\u9898\u6216\u7591\u95ee\uff0c\u8bf7\u8054\u7cfb\u6211\u4eec\u3002","title":"Drupal \u8ba1\u7b97\u5de2\u5feb\u901f\u90e8\u7f72"},{"location":"#_1","text":"Drupal \u662f\u4f7f\u7528 PHP \u7f16\u5199\u7684\u5f00\u6e90\u5185\u5bb9\u7ba1\u7406\u6846\u67b6\uff08CMF\uff09\uff0c\u7531\u5185\u5bb9\u7ba1\u7406\u7cfb\u7edf\uff08CMS\uff09\u4e0e PHP \u5f00\u53d1\u6846\u67b6\u5171\u540c\u6784\u6210\uff0c\u53ef\u7528\u4e8e\u6784\u5efa\u4ece\u4e2a\u4eba\u535a\u5ba2\u5230\u5927\u578b\u793e\u533a\u7684\u5404\u7c7b\u52a8\u6001\u7f51\u7ad9\u3002\u66f4\u591a\u4fe1\u606f\uff0c\u8bf7\u53c2\u89c1 Drupal \u5b98\u7f51 \u3002 \u672c\u6587\u4ecb\u7ecd\u5982\u4f55\u4f7f\u7528\u8ba1\u7b97\u5de2\u90e8\u7f72 Drupal \u793e\u533a\u7248\u670d\u52a1\u5b9e\u4f8b\u3002\u90e8\u7f72\u5b8c\u6210\u540e\uff0c\u73af\u5883\uff08Ubuntu 24.04 + Apache2 + PHP 8.3 + RDS MySQL 8.0\uff09\u4e0e Drupal 11 \u7ad9\u70b9\u5747\u5df2\u81ea\u52a8\u88c5\u597d\uff0c\u76f4\u63a5\u767b\u5f55\u540e\u53f0\u5373\u53ef\u5f00\u59cb\u4f7f\u7528\uff0c\u65e0\u9700\u518d\u6267\u884c\u5b89\u88c5\u5411\u5bfc\u3002","title":"\u6982\u8ff0"},{"location":"#_2","text":"\u90e8\u7f72 Drupal \u793e\u533a\u7248\u670d\u52a1\u5b9e\u4f8b\uff0c\u9700\u8981\u5bf9\u90e8\u5206\u963f\u91cc\u4e91\u8d44\u6e90\u8fdb\u884c\u8bbf\u95ee\u548c\u521b\u5efa\u64cd\u4f5c\u3002\u56e0\u6b64\u60a8\u7684\u8d26\u53f7\u9700\u8981\u5305\u542b\u5982\u4e0b\u8d44\u6e90\u7684\u6743\u9650\u3002 \u8bf4\u660e \uff1a\u5f53\u60a8\u7684\u8d26\u53f7\u662f RAM \u8d26\u53f7\u65f6\uff0c\u624d\u9700\u8981\u6dfb\u52a0\u6b64\u6743\u9650\u3002 \u6743\u9650\u7b56\u7565\u540d\u79f0 \u5907\u6ce8 AliyunECSFullAccess \u7ba1\u7406\u4e91\u670d\u52a1\u5668\u670d\u52a1\uff08ECS\uff09\u7684\u6743\u9650 AliyunVPCFullAccess \u7ba1\u7406\u4e13\u6709\u7f51\u7edc\uff08VPC\uff09\u7684\u6743\u9650 AliyunROSFullAccess \u7ba1\u7406\u8d44\u6e90\u7f16\u6392\u670d\u52a1\uff08ROS\uff09\u7684\u6743\u9650 AliyunRDSFullAccess \u7ba1\u7406\u4e91\u6570\u636e\u5e93\u670d\u52a1\uff08RDS\uff09\u7684\u6743\u9650 AliyunComputeNestUserFullAccess \u7ba1\u7406\u8ba1\u7b97\u5de2\u670d\u52a1\uff08ComputeNest\uff09\u7684\u7528\u6237\u4fa7\u6743\u9650","title":"\u524d\u63d0\u6761\u4ef6"},{"location":"#_3","text":"Drupal \u793e\u533a\u7248\u7684\u8d39\u7528\u4e3b\u8981\u6d89\u53ca\uff1a \u6240\u9009 ECS \u5b9e\u4f8b\u89c4\u683c\uff08vCPU \u4e0e\u5185\u5b58\uff09 RDS \u5b9e\u4f8b\u89c4\u683c\u4e0e\u5b58\u50a8\u5927\u5c0f \u7cfb\u7edf\u76d8\u7c7b\u578b\u53ca\u5bb9\u91cf \u516c\u7f51\u5e26\u5bbd","title":"\u8ba1\u8d39\u8bf4\u660e"},{"location":"#_4","text":"","title":"\u90e8\u7f72\u67b6\u6784"},{"location":"#_5","text":"\u53c2\u6570\u7ec4 \u53c2\u6570\u9879 \u8bf4\u660e \u670d\u52a1\u5b9e\u4f8b \u670d\u52a1\u5b9e\u4f8b\u540d\u79f0 \u957f\u5ea6\u4e0d\u8d85\u8fc7 64 \u4e2a\u5b57\u7b26\uff0c\u5fc5\u987b\u4ee5\u82f1\u6587\u5b57\u6bcd\u5f00\u5934\uff0c\u53ef\u5305\u542b\u6570\u5b57\u3001\u82f1\u6587\u5b57\u6bcd\u3001\u77ed\u5212\u7ebf\uff08-\uff09\u548c\u4e0b\u5212\u7ebf\uff08_\uff09 \u5730\u57df \u670d\u52a1\u5b9e\u4f8b\u90e8\u7f72\u7684\u5730\u57df \u4ed8\u8d39\u7c7b\u578b \u8d44\u6e90\u7684\u8ba1\u8d39\u7c7b\u578b\uff0c\u652f\u6301\u6309\u91cf\u4ed8\u8d39\u4e0e\u5305\u5e74\u5305\u6708 \u7f51\u7edc\u914d\u7f6e \u53ef\u7528\u533a ECS \u5b9e\u4f8b\u4e0e\u4ea4\u6362\u673a\u6240\u5728\u53ef\u7528\u533a \u4e13\u6709\u7f51\u7edc VPC \u8d44\u6e90\u6240\u5728 VPC \u4ea4\u6362\u673a \u8d44\u6e90\u6240\u5728\u4ea4\u6362\u673a\uff0c\u9700\u4e0e\u4e0a\u9762\u6240\u9009\u53ef\u7528\u533a\u4e00\u81f4 ECS \u5b9e\u4f8b\u914d\u7f6e \u5b9e\u4f8b\u7c7b\u578b ECS \u5b9e\u4f8b\u89c4\u683c\uff0c\u53ef\u9009 ecs.u1 \u3001 ecs.e \u7cfb\u5217 \u5b9e\u4f8b\u5bc6\u7801 \u670d\u52a1\u5668\u767b\u5f55\u5bc6\u7801\uff0c\u957f\u5ea6 8~30\uff0c\u5fc5\u987b\u5305\u542b\u5927\u5199\u5b57\u6bcd\u3001\u5c0f\u5199\u5b57\u6bcd\u3001\u6570\u5b57\u3001\u7279\u6b8a\u7b26\u53f7\u56db\u7c7b\u4e2d\u7684\u81f3\u5c11\u4e09\u7c7b \u6570\u636e\u5e93\u914d\u7f6e \u6570\u636e\u5e93\u5b9e\u4f8b\u89c4\u683c RDS MySQL 8.0 \u5b9e\u4f8b\u89c4\u683c \u6570\u636e\u5e93\u5b9e\u4f8b\u5b58\u50a8 RDS \u5b58\u50a8\u5927\u5c0f\u8303\u56f4 20~2000\uff0c\u6bcf 5 GB \u9012\u589e\uff0c\u9ed8\u8ba4 20 GB \u6570\u636e\u5e93\u8d26\u53f7\u540d\u79f0 Drupal \u8fde\u63a5 RDS \u4f7f\u7528\u7684\u8d26\u53f7\u540d\u79f0\uff0c\u9ed8\u8ba4 drupal_admin \uff0c\u5c0f\u5199\u5b57\u6bcd\u5f00\u5934\uff0c\u957f\u5ea6 2~16 \u6570\u636e\u5e93\u5bc6\u7801 RDS \u8d26\u53f7\u5bc6\u7801\uff0c\u957f\u5ea6 8~32\uff0c\u7531\u5b57\u6bcd\u3001\u6570\u5b57\u4e0e _-!@#$%^&*()+= \u7ec4\u6210 Drupal \u914d\u7f6e Drupal \u7ba1\u7406\u5458\u5bc6\u7801 Drupal \u540e\u53f0\u7ba1\u7406\u5458 drupal_admin \u7684\u521d\u59cb\u5bc6\u7801\uff0c\u957f\u5ea6 8~32\uff0c\u7531\u5b57\u6bcd\u3001\u6570\u5b57\u4e0e _-!@#$%^&*()+= \u7ec4\u6210","title":"\u53c2\u6570\u8bf4\u660e"},{"location":"#_6","text":"\u8bbf\u95ee\u8ba1\u7b97\u5de2 Drupal \u793e\u533a\u7248 \u90e8\u7f72\u94fe\u63a5 \uff0c\u6309\u63d0\u793a\u586b\u5199\u90e8\u7f72\u53c2\u6570\u3002 \u53c2\u6570\u586b\u5199\u5b8c\u6210\u540e\u53ef\u4ee5\u770b\u5230\u5bf9\u5e94\u8be2\u4ef7\u660e\u7ec6\uff0c\u786e\u8ba4\u53c2\u6570\u540e\u70b9\u51fb \u4e0b\u4e00\u6b65\uff1a\u786e\u8ba4\u8ba2\u5355 \u3002 \u786e\u8ba4\u8ba2\u5355\u5b8c\u6210\u540e\u540c\u610f\u670d\u52a1\u534f\u8bae\u5e76\u70b9\u51fb \u7acb\u5373\u521b\u5efa \u8fdb\u5165\u90e8\u7f72\u9636\u6bb5\u3002 \u90e8\u7f72\u6210\u529f\u540e\u8fdb\u5165\u670d\u52a1\u5b9e\u4f8b\u8be6\u60c5\u9875\uff0c\u5728 \u8f93\u51fa \u4e2d\u53ef\u4ee5\u770b\u5230\u4ee5\u4e0b\u5730\u5740\u4e0e\u8d26\u53f7\uff1a \u8f93\u51fa \u8bf4\u660e DrupalEndpoint \u7ad9\u70b9\u9996\u9875\u5730\u5740\uff0c\u5f62\u5982 http://<\u516c\u7f51IP> AdminUrl \u540e\u53f0\u767b\u5f55\u5730\u5740\uff0c\u5f62\u5982 http://<\u516c\u7f51IP>/user/login AdminUsername \u540e\u53f0\u7ba1\u7406\u5458\u8d26\u53f7\uff0c\u56fa\u5b9a\u4e3a drupal_admin DBConnectString RDS \u5185\u7f51\u8fde\u63a5\u5730\u5740 \u6253\u5f00 DrupalEndpoint \uff0c\u7ad9\u70b9\u5df2\u7ecf\u521d\u59cb\u5316\u5b8c\u6210\uff0c\u53ef\u4ee5\u76f4\u63a5\u8bbf\u95ee\uff1b\u65e0\u9700\u518d\u6267\u884c\u5b89\u88c5\u5411\u5bfc\u3002 \u6253\u5f00 AdminUrl \uff0c\u4f7f\u7528\u8d26\u53f7 drupal_admin \u4e0e\u90e8\u7f72\u65f6\u586b\u5199\u7684 Drupal \u7ba1\u7406\u5458\u5bc6\u7801 \u767b\u5f55\u540e\u53f0\uff0c\u5373\u53ef\u5f00\u59cb\u521b\u5efa\u5185\u5bb9\u3002","title":"\u90e8\u7f72\u6d41\u7a0b"},{"location":"#_7","text":"\u7ec4\u4ef6 \u7248\u672c/\u8bf4\u660e \u64cd\u4f5c\u7cfb\u7edf Ubuntu 24.04 LTS Web \u670d\u52a1\u5668 Apache2 + PHP 8.3\uff08mod_php\uff09 \u6570\u636e\u5e93 \u963f\u91cc\u4e91 RDS MySQL 8.0\uff08\u5185\u7f51\u8fde\u63a5\uff0c\u4e0d\u5360\u7528 ECS \u8d44\u6e90\uff09 Drupal Drupal 11 \u5b98\u65b9\u53d1\u5e03\u5305 \u7ad9\u70b9\u76ee\u5f55 /opt/drupal \u6587\u4ef6\u76ee\u5f55 /opt/drupal/sites/default/files \u9884\u7f6e\u5185\u5bb9\u7c7b\u578b \u5df2\u542f\u7528 Article \u3001 Basic page Drupal \u7684\u5b89\u88c5\u7a0b\u5e8f\u7531\u955c\u50cf\u5728\u6784\u5efa\u9636\u6bb5\u9884\u7f6e\u3001\u90e8\u7f72\u9636\u6bb5\u81ea\u52a8\u5b8c\u6210\uff0c\u6570\u636e\u5e93\u8fde\u63a5\u3001\u7ad9\u70b9\u4fe1\u606f\u3001\u7ba1\u7406\u5458\u8d26\u53f7\u5bc6\u7801\u5747\u5df2\u81ea\u52a8\u5199\u5165\uff0c\u7528\u6237\u65e0\u9700\u624b\u5de5\u5b89\u88c5\u3002","title":"\u5df2\u5b89\u88c5\u7684\u8f6f\u4ef6\u4e0e\u914d\u7f6e"},{"location":"#_8","text":"\u955c\u50cf\u4e0e\u6a21\u677f\u5df2\u5b8c\u6210\u4ee5\u4e0b\u52a0\u56fa\uff0c\u65e0\u9700\u989d\u5916\u64cd\u4f5c\uff1a vendor/ \u3001 composer.json \u3001 composer.lock \u3001 README.md \u7b49\u975e Web \u8d44\u6e90\u7981\u6b62\u8bbf\u95ee\uff1b core/install.php \u4e0e update.php \u7981\u6b62\u901a\u8fc7\u6d4f\u89c8\u5668\u8bbf\u95ee\uff08\u5347\u7ea7\u8bf7\u5728\u670d\u52a1\u5668\u4e0a\u7528\u547d\u4ee4\u884c\u6267\u884c\uff09\uff1b sites/default/settings.php \u6743\u9650 440\uff0cWeb \u8fdb\u7a0b\u4e0d\u53ef\u5199\u3001\u4e0d\u53ef\u901a\u8fc7\u6d4f\u89c8\u5668\u8bfb\u53d6\uff1b \u6587\u4ef6\u76ee\u5f55 sites/default/files \u5185\u7981\u6b62\u6267\u884c PHP \u811a\u672c\uff0c\u9632\u6b62\u4e0a\u4f20\u540e\u95e8\uff1b PHP \u914d\u7f6e expose_php = Off \uff0c\u54cd\u5e94\u5934\u4e0d\u66b4\u9732 PHP \u7248\u672c\u3002","title":"\u9ed8\u8ba4\u5b89\u5168\u914d\u7f6e"},{"location":"#_9","text":"\u90e8\u7f72\u5b8c\u6210\u540e\u8bbf\u95ee DrupalEndpoint \u6253\u4e0d\u5f00\u600e\u4e48\u529e\uff1f \u90e8\u7f72\u5b8c\u6210\u540e\u7ea6 1~2 \u5206\u949f\u5185\u521d\u59cb\u5316\u811a\u672c\u4ecd\u5728\u6267\u884c\uff0c\u8bf7\u7a0d\u7b49\u540e\u5237\u65b0\uff1b\u82e5\u957f\u65f6\u95f4\u65e0\u6cd5\u8bbf\u95ee\uff0c\u53ef\u5728\u670d\u52a1\u5b9e\u4f8b\u8be6\u60c5\u9875\u67e5\u770b\u90e8\u7f72\u65e5\u5fd7\u786e\u8ba4\u521d\u59cb\u5316\u662f\u5426\u62a5\u9519\u3002 \u4e3a\u4ec0\u4e48\u8bbf\u95ee /core/install.php \u6216 /update.php \u8fd4\u56de 403\uff1f \u8fd9\u662f\u9ed8\u8ba4\u52a0\u56fa\u7b56\u7565\uff0c\u907f\u514d\u7ad9\u70b9\u88ab\u91cd\u590d\u5b89\u88c5\u6216\u88ab\u672a\u6388\u6743\u89e6\u53d1\u5347\u7ea7\u3002\u9700\u8981\u6267\u884c\u6570\u636e\u5e93\u66f4\u65b0\u65f6\uff0c\u8bf7\u767b\u5f55 ECS \u540e\u5728 /opt/drupal \u4e0b\u4f7f\u7528 drush \u6216 php core/scripts/db-tools.php \u7b49\u547d\u4ee4\u884c\u65b9\u5f0f\u64cd\u4f5c\u3002 \u5fd8\u8bb0\u7ba1\u7406\u5458\u5bc6\u7801\u600e\u4e48\u529e\uff1f \u53ef\u767b\u5f55 ECS \u5b9e\u4f8b\uff0c\u5728 /opt/drupal \u76ee\u5f55\u4e0b\u6267\u884c drush user:password drupal_admin <\u65b0\u5bc6\u7801> \uff0c\u6216\u91cd\u65b0\u90e8\u7f72\u4e00\u4e2a\u65b0\u7684\u670d\u52a1\u5b9e\u4f8b\u3002 \u80fd\u5426\u7ed1\u5b9a\u81ea\u5df1\u7684\u57df\u540d\u5e76\u5f00\u542f HTTPS\uff1f \u53ef\u4ee5\u3002\u7ad9\u70b9\u9ed8\u8ba4\u4f7f\u7528 http://<\u516c\u7f51IP> \u8bbf\u95ee\uff0c\u5982\u9700\u7ed1\u5b9a\u57df\u540d\u4e0e\u8bc1\u4e66\uff0c\u53ef\u5728 ECS \u4e0a\u81ea\u884c\u914d\u7f6e Apache \u865a\u62df\u4e3b\u673a\uff0c\u6216\u5728\u524d\u7aef\u63a5\u5165\u8d1f\u8f7d\u5747\u8861 / CDN \u7edf\u4e00\u5904\u7406\u8bc1\u4e66\u3002","title":"\u5e38\u89c1\u95ee\u9898"},{"location":"#_10","text":"https://help.aliyun.com/zh/ecs/use-cases/manually-build-a-drupal-website","title":"\u53c2\u8003\u6587\u6863"}]}